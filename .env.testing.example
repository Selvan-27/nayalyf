# =============================================================================
# CUTOFF TESTING CONFIGURATION
# =============================================================================

# Enable testing mode (bypasses production restrictions)
CUTOFF_TESTING_MODE=false

# Bypass time checks completely
CUTOFF_BYPASS_TIME_CHECK=false

# Force specific date for testing (YYYY-MM-DD format)
# Example: CUTOFF_FORCE_DATE=2025-12-01
CUTOFF_FORCE_DATE=

# Custom time for cutoff processing (HH:MM:SS format)
# Default production time is 23:40:00 (11:40 PM IST)
CUTOFF_TEST_TIME=10:00:00

# Safety settings
CUTOFF_REQUIRE_CONFIRMATION=true
CUTOFF_MAX_TEST_RECORDS=100
CUTOFF_ENABLE_ROLLBACK=true

# Logging configuration
CUTOFF_TEST_LOG_LEVEL=debug
CUTOFF_PROD_LOG_LEVEL=info
CUTOFF_LOG_TO_FILE=true

# =============================================================================
# TESTING SCENARIOS EXAMPLES
# =============================================================================

# Scenario 1: Test immediately without any restrictions
# CUTOFF_TESTING_MODE=true
# CUTOFF_BYPASS_TIME_CHECK=true

# Scenario 2: Test at specific time (10:00 AM)
# CUTOFF_TESTING_MODE=true
# CUTOFF_TEST_TIME=10:00:00

# Scenario 3: Test for specific historical date
# CUTOFF_TESTING_MODE=true
# CUTOFF_FORCE_DATE=2025-12-01
# CUTOFF_BYPASS_TIME_CHECK=true

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# Command Examples:
# php artisan cutoff:test repurchase --dry-run
# php artisan cutoff:test both --date=2025-12-01 --force
# php artisan cutoff:test awards --scenario=immediate
# php artisan cutoff:data seed --force
# php artisan cutoff:data status
# php artisan cutoff:data clean
# php artisan cutoff:data reset